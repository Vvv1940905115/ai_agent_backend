# ===================== 服务基础配置 =====================
APP_NAME=ai-agent-backend
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30

# ===================== 大模型（LLM）=====================
# 可选值: doubao(豆包/火山方舟) | deepseek | qwen(通义千问)
LLM_PROVIDER=deepseek
# 若未单独指定模型，下方每个供应商的 *_MODEL 生效
LLM_MODEL=deepseek-chat

# 豆包（火山方舟 Ark，OpenAI 兼容）
# 申请：https://console.volcengine.com/ark → 开通方舟 → API Key 管理
# 注意：DOUBAO_MODEL 必须填「推理接入点 ID」（形如 ep-2024xxxx-xxxxx），不是模型名
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-xxxxxxxx   # 火山方舟「推理接入点 ID」

# DeepSeek（OpenAI 兼容）
# 申请：https://platform.deepseek.com → API keys
# base_url 官方推荐 https://api.deepseek.com（/v1、/v3 为兼容别名，实测同样可用）
# 模型：deepseek-chat（旧版，官方标记 2026-07-24 弃用但保持兼容）
#       deepseek-v4-flash / deepseek-v4-pro（新版，推荐）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（DashScope，OpenAI 兼容模式）
# 申请：https://dashscope.aliyun.com → 右上角「API 密钥」→ 创建密钥
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ===================== 飞书开放平台 =====================
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书群机器人 Webhook（可选，用于免鉴权推送）
FEISHU_BOT_WEBHOOK=

# ===================== 企业微信 =====================
WECOM_CORPID=
WECOM_CORPSECRET=
WECOM_AGENT_ID=

# ===================== 飞书多维表格 =====================
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=

# ===================== 向量知识库 =====================
# 可选值: qwen | doubao | local(本地兜底，无需网络/密钥，仅用于联调)
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=256
VECTOR_DB_PATH=./data/vector_store

# ===================== 抓取策略（反爬友好）=====================
# 每个请求之间的最小间隔（秒），避免高频访问
SCRAPE_RATE_LIMIT=1.0
USER_AGENT=Mozilla/5.0 (compatible; AIgentBot/1.0; +https://your-company.com/bot)

# ===================== AI 选题 =====================
# 默认生成数量 / 风格（可在接口参数覆盖）
TOPIC_DEFAULT_COUNT=5
TOPIC_DEFAULT_STYLE=科普
# 选题去重相似度阈值（0-1，越高越严格）。生成选题时自动合并近似选题，
# 保留信息量更大者，其余标记为重复。可在接口用 enhance=false 关闭质量增强。
TOPIC_DEDUPE_THRESHOLD=0.7

# ===================== 文生视频 / 图生视频（异步任务）=====================
# provider: mock(默认，离线联调，无需密钥) | generic(对接你的第三方 HTTP API)
VIDEO_GEN_PROVIDER=mock
# generic 模式下填写：你的文生视频 API 地址与密钥。
# 默认 generic 适配器按 OpenAI 兼容风格调用：
#   POST {VIDEO_GEN_API_URL}/v1/video/generations  -> 返回 task_id / id / taskId
#   GET  {VIDEO_GEN_API_URL}/v1/video/generations/{task_id}
# 请求体字段：prompt / duration / resolution / style / model / image(图生视频)
# 响应字段兼容：status/state / progress / video_url/url/output / error
# 若实际 API 字段不同，请修改 app/video_gen/client.py 的 _generic_submit/_generic_query。
VIDEO_GEN_API_URL=
VIDEO_GEN_API_KEY=
# 轮询间隔(秒) / 单任务超时(秒) / 限流最大重试次数 / mock 模拟生成耗时(秒)
VIDEO_GEN_POLL_INTERVAL=5
VIDEO_GEN_TASK_TIMEOUT=600
VIDEO_GEN_MAX_RETRIES=3
VIDEO_GEN_MOCK_DELAY=2
# 企业微信任务通知接收人（@all 或具体 userid）
WECOM_NOTIFY_USER=@all
